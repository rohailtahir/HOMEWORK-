public class Homework3 {

    // Stack
    static class MyStack {

        private int[] items;
        private int top;

        public MyStack() {
            items = new int[10];
            top = -1;
        }

        // Add a value to the top of the stack
        public void push(int value) {
            items[++top] = value;
        }

        // Remove and returns the top value
        public int pop() {

            if (isEmpty()) {
                throw new IllegalStateException("Stack is empty");
            }

            return items[top--];
        }

        // Look at the top value without removing it
        public int peek() {

            if (isEmpty()) {
                throw new IllegalStateException("Stack is empty");
            }

            return items[top];
        }

        // Check if the stack is empty
        public boolean isEmpty() {
            return top == -1;
        }
    }

    // Queue

    static class MyQueue {

        private int[] items;
        private int front;
        private int back;

        public MyQueue() {
            items = new int[10];
            front = 0;
            back = 0;
        }

        // Add a value to the back of the queue
        public void enqueue(int value) {
            items[back++] = value;
        }

        // Remove and return the value at the front
        public int dequeue() {

            if (isEmpty()) {
                throw new IllegalStateException("Queue is empty");
            }

            return items[front++];
        }

        // Look at the front value without removing it
        public int peek() {

            if (isEmpty()) {
                throw new IllegalStateException("Queue is empty");
            }

            return items[front];
        }

        // Check if the queue is empty
        public boolean isEmpty() {
            return front == back;
        }
    }


    public static void main(String[] args) {

        // Stack Demonstration

        MyStack stack = new MyStack();

        System.out.println("STACK DEMONSTRATION");
        System.out.println("Adding:");

        stack.push(15);
        System.out.println(15);

        stack.push(25);
        System.out.println(25);

        stack.push(35);
        System.out.println(35);

        stack.push(45);
        System.out.println(45);

        stack.push(55);
        System.out.println(55);

        System.out.println("\nTop item:");
        System.out.println(stack.peek());

        System.out.println("\nRemoving:");
        System.out.println(stack.pop());

        System.out.println("\nRemoving:");
        System.out.println(stack.pop());

        System.out.println("\nNew top:");
        System.out.println(stack.peek());

        System.out.println("\nIs Stack empty?");
        System.out.println(stack.isEmpty());

        // Queue Demonstration

        MyQueue queue = new MyQueue();

        System.out.println("\nQUEUE DEMONSTRATION");
        System.out.println("Adding:");

        queue.enqueue(15);
        System.out.println(15);

        queue.enqueue(25);
        System.out.println(25);

        queue.enqueue(35);
        System.out.println(35);

        queue.enqueue(45);
        System.out.println(45);

        queue.enqueue(55);
        System.out.println(55);

        System.out.println("\nFront item:");
        System.out.println(queue.peek());

        System.out.println("\nRemoving:");
        System.out.println(queue.dequeue());

        System.out.println("\nRemoving:");
        System.out.println(queue.dequeue());

        System.out.println("\nNew front:");
        System.out.println(queue.peek());

        System.out.println("\nIs Queue empty?");
        System.out.println(queue.isEmpty());
    }
}


